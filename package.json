{
  "name": "flotnix-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:create": "node scripts/create-database.js",
    "db:migrate": "node scripts/migrate.js",
    "db:assign-legacy": "node scripts/assign-legacy-companies.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "node scripts/setup.js",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.js\" \"scripts/*.js\" \"test/*.js\" README.md package.json docker-compose.yml"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "typeorm": "^0.3.27",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "prettier": "^3.9.10"
  }
}
